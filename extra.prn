    printf("==================================================\n");
    printf("Tasks: [A, A, A, B, B, B], Cooldown Interval n = %d\n", n);
    int intervals = leastInterval(tasks, size, n);
    printf("Minimum CPU Intervals Required: %d\n", intervals);
    printf("Execution Schedule: A -> B -> idle -> A -> B -> idle -> A -> B\n");
