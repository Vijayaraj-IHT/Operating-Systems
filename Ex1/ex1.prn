#include <stdio.h>
#include <unistd.h>

int main() 
{
    pid_t pid = fork();

    if (pid == 0) 
    {             
        printf("P2: PID=%d Parent=%d\n", getpid(), getppid());
        pid = fork();
        if (pid == 0) 
        {        
            printf("P3: PID=%d Parent=%d\n", getpid(), getppid());
        }
    }
    if (pid > 0) 
    {            
        printf("P1: PID=%d Parent=%d\n", getpid(), getppid());
        pid = fork();
        if (pid == 0) 
        {         
            printf("P4: PID=%d Parent=%d\n", getpid(), getppid());
        }
    }
    return 0;
}
